# Twitter API v2
TWITTER_BEARER_TOKEN=

# OpenAI (TTS)
OPENAI_API_KEY=

# LLM backend: "claude-cli" (default) or "openrouter"
# LLM_BACKEND=claude-cli

# OpenRouter (LLM fallback, only needed when LLM_BACKEND=openrouter)
OPENROUTER_API_KEY=

# Volcengine Doubao TTS (only needed when tts_provider=doubao)
VOLCENGINE_TTS_APPID=
VOLCENGINE_TTS_TOKEN=

# 服务器公开访问地址（仅本地开发 FastAPI 时使用）
# SERVER_BASE_URL=http://localhost:8000

# 阿里云 OSS（音频 + 封面托管）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET_NAME=
OSS_CDN_URL=https://cdn.example.com

# GitHub Pages 站点地址（feed.xml、封面、文本文件托管）
SITE_URL=https://podcast.example.com
